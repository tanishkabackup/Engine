{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Serilog": {
    "MinimumLevel": "Information"
  },

  "LogSettings": {
    "LogTableName": "",
    "LogFilePath": ""
  },

  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SecretKey": "",
    "ExpiryTime": 60
  },

  "AuthCookies": {
    "SameSite": 0,
    "AccessTokenMinutes": 1,
    "RefreshTokenDays": 1,
    "AccessCookieName": "__Host-TaskInsight-Access",
    "RefreshCookieName": "__Host-TaskInsight-Refresh",
    "RefreshPath": "/User/Refresh"
  },

  "Redis": {
    "ConnectionStrings": "",
    "ExpiryTime": 1
  },

  "SignalR": {
    "ImpedimentHub": "/hubs/impediments",
    "RiskHub": "/hubs/risks"

  },

  "RiskEngine": {
    "Thresholds": {
      "Critical": 70,
      "Attention": 40,
      "Monitor": 1
    },
    "Weights": {
      "OverDue": 40,
      "BlockerPresent": 10,
      "BlockerNoActivity": 20
    },
    "MovementRules": {
      "EscalationLimit": 20,
      "ImprovementLimit": -15,
      "StabilityTolerance": 2
    }
  },

  "AllowedHosts": "*"
}
