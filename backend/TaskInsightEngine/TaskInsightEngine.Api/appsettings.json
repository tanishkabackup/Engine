{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=TaskInsightEngine;UserName=postgres;Password=testtan;"
  },

  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "Host=localhost;Port=5432;Database=TaskInsightEngine;Username=postgres;Password=testtan;",
          "tableName": "Logs",
          "autoCreateSqlTable": true,
          "restrictedToMiniumLevel": "Information"

        }
      }
    ]
  },

  "LogSettings": {
    "LogTableName": "Logs",
    "LogFilePath": "C:\\Temp\\TaskInsightAPILogs\\Log.txt"
  },

  "Jwt": {
    "Issuer": "TaskInsightEngineApi",
    "Audience": "TaskInsightEngineUsers",
    "SecretKey": "your-super-secret-key-min-32-characters-long-123454444444444444444444444444444444444444",
    "ExpiryTime": 60
  },

  "AuthCookies": {
    "SameSite": 0,
    "AccessTokenMinutes": 1,
    "RefreshTokenDays": 1,
    "AccessCookieName": "__Host-TaskInsight-Access",
    "RefreshCookieName": "__Host-TaskInsight-Refresh",
    "RefreshPath": "/User/Refresh"
  },

  "Redis": {
    "ConnectionStrings": "localhost:6379,abortConnect=false",
    "ExpiryTime": 5
  },

  "SignalR": {
    "ImpedimentHub": "/hubs/impediments",
      "RiskHub": "/hubs/risks"

  },

  "RiskEngine": {
    "Thresholds": {
      "Critical": 70,
      "Attention": 40,
      "Monitor": 1
    },
    "Weights": {
      "OverDue": 40,
      "BlockerPresent": 10,
      "BlockerNoActivity": 20
    },
    "MovementRules": {
      "EscalationLimit": 20,
      "ImprovementLimit": -15,
      "StabilityTolerance": 2
    }
  },

  "AllowedHosts": "*"
}
